# Copy to .env (or .env.local) and fill in. Both are git-ignored. Never commit keys.

# Free tier (recommended first): text, vision (photos of briefs) and Whisper speech-to-text.
GROQ_API_KEY=

# Paid escalation, used only when the free tier is rate-limited or fails Clara's quote check.
ANTHROPIC_API_KEY=

# Optional: acoustic speaker separation for class audio (ElevenLabs Scribe). Off unless set.
ELEVENLABS_API_KEY=

# Reminders on phones (Web Push). Create the pair once with: npx web-push generate-vapid-keys
# Without them the app works, and Settings points the student to the calendar instead.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-app.example.com
# Where the reminder queue is saved. Point it at a mounted volume so it survives redeploys.
# CLARA_DATA_DIR=/data

# Routing (see docs/13_cost_and_routing.md)
# CLARA_ROUTE=groq,anthropic        # "groq" = free only · "anthropic" = paid only
# CLARA_STT=groq,elevenlabs         # speech-to-text order
# CLARA_GROQ_MODEL=openai/gpt-oss-120b
# CLARA_GROQ_VISION_MODEL=qwen/qwen3.8-27b
# CLARA_GROQ_STT_MODEL=whisper-large-v3
# CLARA_MODEL=claude-sonnet-5-5     # Anthropic escalation model
# CLARA_EFFORT=medium
# CLARA_ACCESS_CODE=                # if set, a public demo asks for this code before calling the AI
